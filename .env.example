# ============================================================
#  Secrets — set these in Vercel → Project → Settings → Environment Variables
#  For local dev: copy this file to .env.local and fill in.
# ============================================================

# Upstash Redis — added AUTOMATICALLY when you connect Upstash from Vercel → Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# PIN for /admin (choose your own, not shared with karyawan)
ADMIN_PIN=

# WhatsApp via Fonnte (https://fonnte.com) — Dashboard → Device → Token
FONNTE_TOKEN=
# Where messages go (group IDs) is set in config/app.config.ts, not here.

# Protects /api/cron/notify. Any long random string. Also put it in cron-job.org (see README).
CRON_SECRET=

# Phone notifications (web push). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
